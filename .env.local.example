# ========================================================
# PANDUAN KONFIGURASI FIREBASE AUTH & GOOGLE SSO (DeLIMA)
# ========================================================
# Dapatkan maklumat di bawah daripada Firebase Console:
# https://console.firebase.google.com/
# 1. Pilih atau Cipta Projek Firebase
# 2. Pergi ke Project Settings (Ikon gear) > General > Your apps > Web app (</>)
# 3. Salin nilai firebaseConfig ke pembolehubah di bawah:

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ========================================================
# GOOGLE GEMINI AI API (KPM Pedagogical Assistant)
# ========================================================
# Dapatkan kunci API percuma daripada Google AI Studio:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ========================================================
# SUPABASE DATABASE & RLS
# ========================================================
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
